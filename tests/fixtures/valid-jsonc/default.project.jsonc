{
  // Rojo supports comments and trailing commas in project JSONC files.
  "name": "FixtureGameJsonc",
  "tree": {
    "$className": "DataModel",
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": { "optional": "src/client" },
      },
    },
  },
}
